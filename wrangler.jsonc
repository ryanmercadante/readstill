{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed from GitHub Actions (.github/workflows). Don't also connect
  // Workers Builds in the dashboard, or every push deploys twice.
  "name": "readstill",
  "compatibility_date": "2026-11-15",
  "main": "@tanstack/react-start/server-entry",
  // Staging uploads from main get their own preview URL. Production traffic
  // only moves on a release.
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  // Caps link imports per visitor IP so /api/page and /api/image can't serve as open proxies.
  "ratelimits": [
    {
      "name": "PAGE_IMPORT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    // One article can carry many images; each import fetches up to 30.
    {
      "name": "IMAGE_IMPORT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 150, "period": 60 },
    },
  ],
}
