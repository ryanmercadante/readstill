{
  "name": "still",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @still/web run dev",
    "dev:mobile": "pnpm --filter @still/mobile run start",
    "build": "pnpm --filter @still/web run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @still/web run test:e2e",
    "test:e2e:ui": "pnpm --filter @still/web run test:e2e:ui",
    "preview": "pnpm --filter @still/web run preview",
    "deploy": "pnpm --filter @still/web run deploy",
    "cf-typegen": "pnpm --filter @still/web run cf-typegen",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@still/oxfmt-config": "workspace:*",
    "@still/oxlint-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs,mts,cts})": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.18.0"
}
