{
  "name": "still-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "dev": "vite",
    "build": "vite build && tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview --host 127.0.0.1",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@xstate/react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tw-animate-css": "^1.4.0",
    "xstate": "^5.33.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs,mts,cts})": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@12.18.0"
}
