{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deployed from GitHub Actions (.github/workflows). Don't also connect
  // Workers Builds in the dashboard, or every push deploys twice.
  "name": "readstill",
  "compatibility_date": "2026-11-15",
  "main": "@tanstack/react-start/server-entry",
  // readstill.app is the only way in. The zone handles the http-to-https and
  // www-to-apex redirects before requests reach the Worker; workers.dev and
  // version preview URLs would bypass the zone's settings, so they're off.
  "routes": [{ "pattern": "readstill.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  // Caps link imports per visitor IP so /api/page and /api/image can't serve as open proxies.
  "ratelimits": [
    {
      "name": "PAGE_IMPORT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    // One article can carry many images; each import fetches up to 30.
    {
      "name": "IMAGE_IMPORT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 150, "period": 60 },
    },
  ],
  "env": {
    // Every push to main deploys the readstill-staging Worker to
    // staging.readstill.app. Select it at build time with CLOUDFLARE_ENV=staging;
    // the Vite plugin writes the deploy config for that environment.
    "staging": {
      "routes": [{ "pattern": "staging.readstill.app", "custom_domain": true }],
      // The custom domain is the only way in, so Cloudflare Access on it can't
      // be bypassed through workers.dev or version preview URLs.
      "workers_dev": false,
      "preview_urls": false,
      // Bindings aren't inherited. Separate namespaces keep staging traffic
      // from counting against production's limits.
      "ratelimits": [
        {
          "name": "PAGE_IMPORT_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "IMAGE_IMPORT_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 150, "period": 60 },
        },
      ],
    },
  },
}
